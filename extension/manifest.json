{
  "manifest_version": 3,
  "name": "Channel Studio: exact upload dates",
  "version": "1.0.0",
  "description": "Reads exact upload dates from YouTube video pages and sends them to your Channel Studio dashboard.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Channel Studio dates"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
