# Copy this file to .env and fill it in. Leave DATABASE_URL empty to keep using the local file (data/dashboard.db).

# Turso database: Turso dashboard > your database > the libsql:// URL at the top
DATABASE_URL=
# Turso dashboard > your database > Create Token (Read & Write)
DATABASE_TOKEN=
# How often this node pulls other nodes' changes, in seconds (default 15)
DATABASE_SYNC_SECONDS=15

# Optional: shows this month's Turso usage (rows read/written, storage) on the Database page.
# Turso dashboard > Settings > API Tokens > Create. This is a different token from DATABASE_TOKEN.
TURSO_API_TOKEN=

# ---- Internet access (Vercel page) ----
# Shared by Vercel and every node: signs and checks sign-in passes. Same value everywhere. Keep it private.
# Make one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# quick = give this node a public https address through a Cloudflare quick tunnel (install cloudflared first)
TUNNEL=quick
# Or a fixed public address of your own instead of the tunnel:
# PUBLIC_URL=https://node1.example.com
# Name on the Nodes page (default: the PC name)
# NODE_NAME=Office PC

# Gemini API key for the Topic research AI brief (optional)
GEMINI_API_KEY=
GEMINI_FALLBACK_MODEL=
