{
  "name": "youtube-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite build && vite preview --port 4173 --strictPort",
    "serve:lan": "vite build && vite preview --host --port 4173 --strictPort",
    "autostart:install": "node scripts/autostart.mjs install",
    "autostart:uninstall": "node scripts/autostart.mjs uninstall",
    "autostart:status": "node scripts/autostart.mjs status",
    "stop": "node scripts/stop.mjs",
    "db:check": "node scripts/db-check.mjs",
    "node": "vite build && node server/standalone.js",
    "node:start": "node server/standalone.js"
  },
  "dependencies": {
    "@distube/ytdl-core": "^5.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "libsql": "^0.5.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
